# Copy from Folio .env.mainnet.local — no operator keys needed.
# Mirror Node is public. Service role is read-only in this app.

HEDERA_NETWORK=mainnet
NEXT_PUBLIC_HEDERA_NETWORK=mainnet
NEXT_PUBLIC_HASHSCAN_BASE=https://hashscan.io/mainnet

# Live vault (ECDSA operator — Solidity release() works)
FOLIO_VAULT_CONTRACT_ID=0.0.10853130
FOLIO_VAULT_EVM_ADDRESS=0x0000000000000000000000000000000000a59b0a

# Previous vault — still counted in 30d MAU / deposits (bytecode cannot be replaced)
FOLIO_VAULT_PREVIOUS_CONTRACT_ID=0.0.10682456
FOLIO_VAULT_PREVIOUS_EVM_ADDRESS=0x0000000000000000000000000000000000a30058
FOLIO_VAULT_CUTOVER_DATE=2026-09-10

HEDERA_OPERATOR_ID=0.0.10680786

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional
# HEDERA_MIRROR_NODE_URL=https://mainnet-public.mirrornode.hedera.com
# USDC_TOKEN_ID=0.0.456858
