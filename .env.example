# Copy from Folio .env.mainnet.local / .env.local — no operator keys needed.
# Mirror Node is public. Service role is read-only in this app.

HEDERA_NETWORK=mainnet
NEXT_PUBLIC_HEDERA_NETWORK=mainnet
NEXT_PUBLIC_HASHSCAN_BASE=https://hashscan.io/mainnet

FOLIO_VAULT_CONTRACT_ID=0.0.10682456
FOLIO_VAULT_EVM_ADDRESS=0x0000000000000000000000000000000000a30058
HEDERA_OPERATOR_ID=0.0.xxxxx

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional
# HEDERA_MIRROR_NODE_URL=https://mainnet-public.mirrornode.hedera.com
